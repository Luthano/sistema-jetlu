# Credenciais SSW (cotação+coleta SOAP + rastreio PF + cidades)
# Cotação e coleta: https://ssw.inf.br/ws/sswCotacaoColeta/help.html
# Mercadorias: https://ssw.inf.br/ws/sswCotacao/help.html
# Cidades atendidas: https://ssw.inf.br/ajuda/areas.html
# Rastreio DANFE: https://ssw.inf.br/ajuda/trackingdanfe.html
# Rastreio PF (usa dominio/usuario/senha): https://ssw.inf.br/ajuda/trackingpf.html
#
# Local: copie este arquivo para .env e preencha os valores.
# Vercel: as chaves VITE_SUPABASE_* também vão em .env.production (commitadas, são públicas).
# Senhas SSW ficam só no .env local e em Project Settings > Environment Variables.
# Não envie o arquivo .env para o GitHub.

SSW_DOMINIO=
SSW_LOGIN=
SSW_SENHA=
SSW_COTACAO_URL=https://ssw.inf.br/ws/sswCotacao/index.php
SSW_COTACAO_COLETA_URL=https://ssw.inf.br/ws/sswCotacaoColeta/index.php
SSW_AREAS_URL=https://ssw.inf.br/2/areas
SSW_CIDADES_ORIGEM=CASCAVEL / PR,MARINGA / PR,LONDRINA / PR
PORT=3001

# Supabase (Project Settings > API Keys)
# URL: Project Settings > Data API > Project URL
# Chave: aba "Publishable and secret" > Publishable key (sb_publishable_...)
# Nunca coloque sb_secret_ nem service_role no front.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
